%% C4 Level 1: System Context (DRAFT) · Production Planning Copilot · Nahda Beverages (fictional)
flowchart LR
    planner["👤 Production planner<br/><i>[Person]</i><br/>Approves/edits proposals"]
    sup["👤 Shift supervisor<br/><i>[Person]</i><br/>Asks questions, writes handover notes"]
    pm["👤 Plant manager<br/><i>[Person]</i><br/>Approves overtime & escalations"]

    copilot["<b>Production Planning Copilot</b><br/><i>[Software System]</i><br/>Detects disruptions, proposes feasible<br/>re-plans, explains trade-offs (AR/EN)"]

    erp["ERP<br/><i>[Existing]</i><br/>Orders, BOM, materials"]
    aps["Planning tool / APS<br/><i>[Existing]</i><br/>Current schedule"]
    mes["MES / SCADA via OT DMZ gateway<br/><i>[Existing, OT zone]</i><br/>Machine states, counts"]
    cmms["CMMS<br/><i>[Existing]</i><br/>Maintenance plan, repair ETA"]
    docs["Document store<br/><i>[Existing]</i><br/>Planning rules, SOPs"]
    llm["LLM service<br/><i>[In-region API or self-hosted]</i>"]

    planner -->|"Reviews proposals, decides [Web UI]"| copilot
    sup -->|"Questions, notes [Web/mobile]"| copilot
    copilot -->|"Escalations needing approval"| pm
    copilot -->|"Reads orders, materials [REST, read-only]"| erp
    copilot -->|"Reads schedule; submits APPROVED draft changes [API]"| aps
    mes -->|"Events & counts [one-way, MQTT/historian]"| copilot
    copilot -->|"Reads PM windows, repair ETA [REST]"| cmms
    copilot -->|"Indexes rules & SOPs [batch]"| docs
    copilot -->|"Explanations, note analysis [HTTPS]"| llm

    classDef person fill:#08427b,color:#fff,stroke:#052e56
    classDef system fill:#1168bd,color:#fff,stroke:#0b4884
    classDef ext fill:#999,color:#fff,stroke:#6b6b6b
    classDef ot fill:#b85c00,color:#fff,stroke:#7a3d00
    class planner,sup,pm person
    class copilot system
    class erp,aps,cmms,docs,llm ext
    class mes ot
