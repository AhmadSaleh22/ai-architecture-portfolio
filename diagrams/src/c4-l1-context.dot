// C4 Level 1 - System context: Hesal
// Render: dot -Tsvg src/c4-l1-context.dot -o c4-l1-context.svg
digraph L1 {
  rankdir=TB; nodesep=0.6; ranksep=0.9;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#555555", fillcolor="#eeeeee", margin="0.2,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#666666"];

  employee [label="Employee\n[Person]\nSaves, plans, applies for\nloans and services", fillcolor="#08427b", fontcolor="white"];
  admins   [label="HR, finance, CEO\n[Person]\nManage employees and salaries,\napprove requests", fillcolor="#08427b", fontcolor="white"];
  team     [label="Hesal team\n[Person]\nAdds services, sends\napplications to partners", fillcolor="#08427b", fontcolor="white"];
  shariah  [label="Shariah board\n[Person]\nApproves product terms", fillcolor="#08427b", fontcolor="white"];

  hesal [label="Hesal\n[Software system]\nSalaries, savings, qard hasan, lease-to-own,\nservices, and an AI assistant for the employee", fillcolor="#1168bd", fontcolor="white", width=3.4];

  cobank  [label="Company's bank\n[External]\nPays salaries"];
  pbank   [label="Partner bank\n[External]\nSavings accounts in\nthe employee's name"];
  partner [label="Partner companies\n[External]\nInsurance, cars, instalments"];
  llm     [label="LLM provider\n[External, hosted in KSA]"];

  employee -> hesal [label="saves, chats, uploads\nbank statement, applies"];
  admins   -> hesal [label="manage, approve;\nsee totals only"];
  team     -> hesal [label="manage services"];
  shariah  -> hesal [label="approved terms"];
  hesal -> cobank  [label="salary run"];
  hesal -> pbank   [label="monthly savings transfer"];
  hesal -> partner [label="applications the\nemployee confirmed"];
  hesal -> llm     [label="chat, plans, statements\n(no names)"];
}
