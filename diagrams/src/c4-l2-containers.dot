// C4 Level 2 - Containers: inside Hesal
// Render: dot -Tsvg src/c4-l2-containers.dot -o c4-l2-containers.svg
digraph L2 {
  rankdir=LR; nodesep=0.45; ranksep=0.8;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#555555", fillcolor="#eeeeee", margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=8, color="#666666"];

  { rank=source;
    employee [label="Employee\n[Person]", fillcolor="#08427b", fontcolor="white"];
    admins   [label="HR, finance, CEO\n[Person]", fillcolor="#08427b", fontcolor="white"];
    team     [label="Hesal team\n[Person]", fillcolor="#08427b", fontcolor="white"];
  }

  subgraph cluster_sys {
    label="Hesal (cloud region in KSA)"; fontname="Helvetica"; fontsize=11; style="rounded"; color="#1168bd";
    node [fillcolor="#438dd5", fontcolor="white"];
    app     [label="Employee app\n[Web / mobile]\nSavings, requests, chat"];
    portal  [label="Admin portal\n[Web]\nEmployees, salaries,\napprovals, totals"];
    core    [label="Core API\n[Backend]\nAccounts, savings, requests,\napproval chains"];
    rules   [label="Rules engine\n[Code]\nEligibility for loans,\nlease-to-own and services"];
    asst    [label="Assistant\n[LLM client + guardrails]\nMoney plans, questions;\nsees only the signed-in employee"];
    agent   [label="Application agent\n[LLM + tools]\nPrepares service applications;\nno withdraw tool"];
    reader  [label="Statement reader\n[Worker]\nTurns a statement into\ncategory totals"];
    rec     [label="Recommender\n[ML]\nServices that are allowed,\naffordable and relevant"];
    coredb  [label="Core DB\n[PostgreSQL]\nEmployees, savings,\nrequests", shape=cylinder];
    pfdb    [label="Personal finance store\n[PostgreSQL, encrypted]\nStatements (1 year),\ncategory totals\nNo employer access", shape=cylinder];
    docs    [label="Documents index\n[PostgreSQL + pgvector]\nTerms, company policies,\nservice details", shape=cylinder];
    gw      [label="LLM gateway\n[Service]\nRemoves names, checks input\nand output, logs every call"];
    audit   [label="Audit log\n[Append-only]\nEvery AI answer and action", shape=cylinder];
  }

  { rank=sink;
    cobank  [label="Company's bank"];
    pbank   [label="Partner bank"];
    partner [label="Partner companies"];
    llm     [label="LLM provider\n(KSA)"];
  }

  employee -> app [label="HTTPS"];
  admins -> portal; team -> portal;
  app -> core; portal -> core;
  app -> asst [label="chat"];
  app -> reader [label="upload statement"];
  core -> rules;
  core -> coredb;
  core -> cobank [label="salary run"];
  core -> pbank [label="savings"];
  core -> partner [label="confirmed applications\n(via Hesal team)"];
  asst -> agent [label="apply for a service"];
  agent -> rules [label="check eligibility"];
  agent -> core [label="draft request,\nwaits for approvals"];
  asst -> pfdb [label="own data only"];
  asst -> docs [label="search"];
  asst -> rec;
  rec -> rules;
  reader -> pfdb;
  asst -> gw; agent -> gw; reader -> gw;
  gw -> llm;
  gw -> audit;
}
